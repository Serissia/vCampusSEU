<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vcampus</groupId>
        <artifactId>vCampusSEU</artifactId>
        <!-- 请确保这里的版本号与根目录 pom.xml 里的 <version> -->
        <version>1.3</version>
        <!-- 指定从上级目录寻找父 POM，防止 Maven 尝试去远程仓库下载 -->
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>client</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>17.0.10</javafx.version>
    </properties>

    <dependencies>
        <!-- 依赖 common 模块（Message、VO 等实体） -->
        <dependency>
            <groupId>com.vcampus</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JavaFX 基础控件与图形库 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX FXML 布局支持 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX Swing 互操作，用于将课表节点导出为图片 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Apache POI：学生名单导出为 Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.0</version>
        </dependency>

        <!-- GSON JSON 序列化库 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 确保 FXML、CSS、图片等资源文件能被打包至 classpath -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- JavaFX 运行插件 -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- 指定客户端的入口类 -->
                    <mainClass>com.vcampus.client.ClientLauncher</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.4.1</version>
                <executions>
                    <execution>
                        <id>l4j-clui</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <headerType>gui</headerType>
                            <!-- 生成的 exe 路径与名称 -->
                            <outfile>${project.build.directory}/vCampusSEU.exe</outfile>
                            <!-- 指向前面打出来的可执行 jar（通常是 maven-shade-plugin 或 assembly 输出的 fat jar） -->
                            <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
                            <errTitle>vCampusSEU 启动错误</errTitle>
                            <classPath>
                                <mainClass>com.vcampus.client.ClientApp</mainClass>
                            </classPath>
                            <!-- 核心：指定本地外观图标路径（相对于 pom.xml 的路径） -->
                            <icon>src/main/resources/images/comseucampus.ico</icon>
                            <!-- JRE 运行环境要求 -->
                            <jre>
                                <minVersion>17</minVersion>
                                <jdkPreference>preferJre</jdkPreference>
                            </jre>
                            <!-- 版本信息与文件属性（右键属性可见） -->
                            <versionInfo>
                                <fileVersion>1.0</fileVersion>
                                <txtFileVersion>1.0</txtFileVersion>
                                <fileDescription>东南大学智慧校园客户端</fileDescription>
                                <copyright>vCampus Team</copyright>
                                <productVersion>1.0</productVersion>
                                <txtProductVersion>1.0</txtProductVersion>
                                <productName>vCampusSEU</productName>
                                <internalName>vCampusSEU</internalName>
                                <originalFilename>vCampusSEU.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
