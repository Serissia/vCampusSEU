<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="580.0" prefWidth="920.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vcampus.client.controller.LoginController">

    <stylesheets>
        <URL value="@../css/tokens.css" />
        <URL value="@../css/base.css" />
        <URL value="@../css/login.css" />
    </stylesheets>

    <!-- 左侧：东南大学艺术画卷与校徽区域 (50% 宽度) -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="login-artwork-container">
        <ImageView fx:id="bgImageView" fitHeight="580.0" fitWidth="460.0"
                   preserveRatio="false" styleClass="login-artwork-image" />

        <VBox alignment="CENTER" spacing="12.0" styleClass="artwork-overlay">
            <ImageView fx:id="logoImageView" fitHeight="72.0" fitWidth="72.0" preserveRatio="true" />
            <Label text="東 南 大 學" styleClass="artwork-title-cn" />
            <Label text="SOUTHEAST UNIVERSITY" styleClass="artwork-title-en" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="8.0" styleClass="carousel-dots">
                <Region styleClass="dot" />
                <Region styleClass="dot, active" />
                <Region styleClass="dot" />
                <Region styleClass="dot" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- 右侧：统一身份认证表单区域 (50% 宽度) -->
    <VBox alignment="CENTER_LEFT" prefWidth="460.0" spacing="24.0" styleClass="login-form-container">
        <padding>
            <Insets bottom="40.0" left="55.0" right="55.0" top="40.0" />
        </padding>

        <VBox spacing="6.0">
            <Label text="统一身份认证" styleClass="login-main-title" />
            <Region prefHeight="3.0" prefWidth="36.0" styleClass="title-accent-bar" />
        </VBox>

        <VBox spacing="6.0">
            <Label text="用户名" styleClass="input-label" />
            <TextField fx:id="usernameField" promptText="请输入一卡通号 / 别名"
                       styleClass="modern-underline-field" />
        </VBox>

        <VBox spacing="6.0">
            <Label text="密码" styleClass="input-label" />
            <PasswordField fx:id="passwordField" promptText="请输入密码"
                           styleClass="modern-underline-field" />
        </VBox>

        <HBox alignment="CENTER_RIGHT">
            <Hyperlink onAction="#handleForgotPassword" text="忘记密码？" styleClass="forget-pwd-link" />
        </HBox>

        <Label fx:id="errorLabel" managed="false" visible="false" styleClass="error-message-label" />

        <StackPane>
            <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin"
                    prefHeight="42.0" text="登  录" styleClass="login-primary-btn" />
            <ProgressIndicator fx:id="loadingIndicator" maxHeight="24.0" maxWidth="24.0"
                               visible="false" styleClass="login-spinner" />
        </StackPane>
    </VBox>
</HBox>