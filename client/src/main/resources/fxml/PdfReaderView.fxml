<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane styleClass="pdf-reader-root"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vcampus.client.controller.PdfReaderController">
    <stylesheets>
        <URL value="@../css/tokens.css" />
        <URL value="@../css/base.css" />
        <URL value="@../css/library.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="pdf-reader-header">
            <Button fx:id="backButton" text="返回" onAction="#handleBack" styleClass="btn-recharge-preset" />
            <Label fx:id="readerTitleText" text="在线浏览" styleClass="lib-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="服务器电子资源" styleClass="lib-subtitle" />
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="pdfScroll" fitToWidth="true" fitToHeight="true" styleClass="pdf-page-scroll">
            <ImageView fx:id="pdfImageView" preserveRatio="true" />
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="16.0" styleClass="pdf-reader-footer">
            <Button fx:id="prevButton" text="上一页" onAction="#handlePrevPage" styleClass="btn-recharge-preset" />
            <Label fx:id="pageIndicatorLabel" text="0 / 0" styleClass="lib-detail-value" />
            <Button fx:id="nextButton" text="下一页" onAction="#handleNextPage" styleClass="btn-recharge-preset" />
        </HBox>
    </bottom>
</BorderPane>
