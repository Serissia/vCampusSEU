<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="rootScrollPane" fitToWidth="true" styleClass="profile-scroll-pane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vcampus.client.controller.NoticeViewController">
    <stylesheets>
        <URL value="@../css/tokens.css" />
        <URL value="@../css/base.css" />
        <URL value="@../css/library.css" />
        <URL value="@../css/notice.css" />
    </stylesheets>
    <VBox spacing="16.0" styleClass="lib-container">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>

        <!-- 顶部卡片：标题、上次抓取时间与手动同步 -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="profile-card">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="教务公告栏" styleClass="lib-title" />
                    <Label fx:id="syncStatusBadge" text="就绪" styleClass="notice-badge" />
                </HBox>
                <Label fx:id="lastSyncLabel" text="上次同步时间：获取中..." styleClass="lib-subtitle" />
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Label text="爬取范围：" styleClass="notice-filter-label" />
                <ComboBox fx:id="syncDaysCombo" prefWidth="110.0" styleClass="academic-combo" />
                <Button fx:id="syncButton" text="手动同步" onAction="#handleTriggerSync" styleClass="btn-primary-action" />
                <ProgressIndicator fx:id="syncSpinner" maxHeight="20.0" maxWidth="20.0" visible="false" />
            </HBox>
        </HBox>

        <!-- 条件筛选卡片：关键词、起止日期与控制按钮 -->
        <VBox spacing="12.0" styleClass="profile-card">
            <Label text="公告检索与筛选" styleClass="lib-section-title" />
            <HBox spacing="12.0" alignment="CENTER_LEFT">
                <TextField fx:id="keywordField" promptText="搜索公告标题关键词..." styleClass="modern-input-field"
                           HBox.hgrow="ALWAYS" onAction="#handleSearch" />
                <Label text="发布日期：" styleClass="notice-filter-label" />
                <DatePicker fx:id="startDatePicker" promptText="起始日期" prefWidth="135.0" styleClass="notice-date-picker" />
                <Label text="至" styleClass="notice-filter-label" />
                <DatePicker fx:id="endDatePicker" promptText="截止日期" prefWidth="135.0" styleClass="notice-date-picker" />
                <Button text="查询" onAction="#handleSearch" styleClass="btn-primary-action" />
                <Button text="重置" onAction="#handleResetFilter" styleClass="btn-recharge-preset" />
            </HBox>
        </VBox>

        <!-- 表格卡片：公告列表与操作提示 -->
        <VBox spacing="10.0" styleClass="profile-card" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="tableSummaryLabel" text="公告列表" styleClass="lib-section-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="💡 双击表格行或点击操作项可在系统默认浏览器中打开原网页" styleClass="notice-tip-label" />
            </HBox>
            <TableView fx:id="noticeTable" prefHeight="480.0" styleClass="lib-table" VBox.vgrow="ALWAYS" />
        </VBox>
    </VBox>
</ScrollPane>