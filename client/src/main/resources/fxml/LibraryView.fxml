<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="libraryRoot"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.vcampus.client.controller.LibraryController">
    <stylesheets>
        <URL value="@../css/tokens.css" />
        <URL value="@../css/base.css" />
        <URL value="@../css/library.css" />
    </stylesheets>

    <ScrollPane fx:id="rootScrollPane" fitToWidth="true" styleClass="profile-scroll-pane">
        <VBox spacing="16.0" styleClass="lib-container">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <!-- 顶部检索工具栏 -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="profile-card">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="图书检索" styleClass="lib-title" />
                    <Label fx:id="libSubtitleText" text="检索馆藏图书，双击条目查看详情" styleClass="lib-subtitle" />
                </VBox>
                <TextField fx:id="searchField" promptText="输入书名 / 作者 / ISBN 检索" styleClass="modern-input-field"
                           HBox.hgrow="ALWAYS" onAction="#handleSearch" />
                <Button text="检索" onAction="#handleSearch" styleClass="btn-primary-action" />
            </HBox>

            <!-- 馆藏书目 -->
            <VBox spacing="12.0" styleClass="profile-card">
                <Label text="馆藏书目" styleClass="lib-section-title" />
                <TableView fx:id="bookTable" prefHeight="320.0" styleClass="lib-table" />
            </VBox>

            <!-- 我的借阅（普通用户可见） -->
            <VBox fx:id="myBorrowSection" spacing="12.0" styleClass="profile-card">
                <Label text="我的借阅" styleClass="lib-section-title" />
                <TableView fx:id="borrowTable" prefHeight="240.0" styleClass="lib-table" />
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
