<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="rootScrollPane" fitToWidth="true" styleClass="profile-scroll-pane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vcampus.client.controller.AcademicViewController">
    <stylesheets>
        <URL value="@../css/tokens.css" />
        <URL value="@../css/base.css" />
        <URL value="@../css/library.css" />
        <URL value="@../css/academic.css" />
    </stylesheets>

    <VBox spacing="16.0" styleClass="lib-container">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>

        <!-- 顶部标题与业务操作工具栏 -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="profile-card">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" text="教务管理" styleClass="lib-title" />
                <Label fx:id="subtitleLabel" text="统一教务业务入口" styleClass="lib-subtitle"
                       wrapText="true" maxWidth="Infinity" />
            </VBox>
            <FlowPane fx:id="headerControls" hgap="8.0" vgap="8.0"
                      alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- 动态表单卡片：课程提交、成绩登记等 -->
        <VBox fx:id="formCard" spacing="12.0" styleClass="profile-card"
              managed="false" visible="false">
            <Label text="业务表单" styleClass="lib-section-title" />
            <VBox fx:id="formContent" spacing="8.0" />
        </VBox>

        <!-- 数据列表卡片 -->
        <VBox fx:id="dataCard" spacing="12.0" styleClass="profile-card" VBox.vgrow="ALWAYS">
            <Label fx:id="sectionLabel" text="数据列表" styleClass="lib-section-title" />
            <TableView fx:id="dataTable" prefHeight="420.0" styleClass="lib-table" />
        </VBox>
    </VBox>
</ScrollPane>
